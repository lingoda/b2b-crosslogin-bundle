parameters:
    tmpDir: .phpstan-cache
    parallel:
        processTimeout: 360.0
    level: 9
    checkMissingCallableSignature: true
    checkFunctionNameCase: true
    treatPhpDocTypesAsCertain: false
    exceptions:
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true
        implicitThrows: true
